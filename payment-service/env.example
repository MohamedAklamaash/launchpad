DJANGO_PORT=8003

DATABASE_USER_NAME=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=payments_db
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
PAYMENTS_DB_URL=postgres://user:password@localhost:5432/payments_db?ssl_mode=disable

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

DJANGO_SECRET=your-secret-key-min-50-characters-long-change-this-in-production
JWT_SECRET=your-jwt-secret-min-32-characters
INTERNAL_API_TOKEN=your-internal-api-token-min-32-characters

STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
# Required. From Stripe Dashboard → Developers → Webhooks → signing secret.
# Service will fail to boot if missing. Webhook signature verification rejects all events without it.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME_FROM_STRIPE_DASHBOARD

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8003
# Required. Public-facing gateway URL Stripe redirects buyers to after checkout.
# Must be reachable from the internet in non-local environments.
PUBLIC_BACKEND_URL=http://localhost:8000

DB_CONN_MAX_AGE=600

# F9 ticket 5: backs OrgPermissions's role cache. Optional — a Redis outage or an
# unconfigured instance both fall back to the database, never to "allow".
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=3

# F9 ticket 4: gates the org.events consumer (Organization/Membership read-model sync).
# On by default (unset = on). Must match auth-service.
# Rollback: ORGS_ENABLED=false (restart; 0, no, off also work, any case). Read plan/F9-teams-and-orgs.md "Cutover checklist"
# first: infrastructure-service refuses to start flag-off once org admins have created infrastructures.
ORGS_ENABLED=True
