NOTIFICATION_SERVICE_PORT=5003
NODE_ENV=development

# Must match INTERNAL_API_TOKEN in every other service and the gateway.
INTERNAL_API_TOKEN=your-internal-api-token-min-32-characters

# Must match JWT_SECRET in auth-service so tokens verify across services.
JWT_SECRET=your-jwt-secret-min-32-characters

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_smtp_user@example.com
# Gmail app password (not your account password).
MAIL_APP_PASSWORD=your_smtp_app_password
FROM_MAIL=your_from_address@example.com

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=1
# REDIS_USERNAME=default
REDIS_MAX_RETRIES=10

MONGODB_URL=mongodb://user:password@localhost:27017/notifications?authSource=admin
MONGO_POOL_SIZE=10
MONGO_CONNECT_TIMEOUT_MS=30000

AUTH_SERVICE_URL=http://localhost:5001/api
GATEWAY_SERVICE_URL=http://localhost:8000

CB_FAILURE_THRESHOLD=5
CB_TIMEOUT_MS=30000
CB_SUCCESS_THRESHOLD=2

HTTP_REQUEST_TIMEOUT_MS=5000
