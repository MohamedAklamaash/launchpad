AUTH_SERVICE_PORT=5001
NODE_ENV=development

# Must match INTERNAL_API_TOKEN in every other service and the gateway.
INTERNAL_API_TOKEN=your-internal-api-token-min-32-characters

DATABASE_USER_NAME=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=auth_db
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
AUTH_DB_URL=postgres://user:password@localhost:5433/auth_db?ssl_mode=disable

DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# Must match JWT_SECRET in the Django services and the other identity services.
JWT_SECRET=your-jwt-secret-min-32-characters
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=1d

# Origin only (scheme://host[:port]) — no path/query/fragment. GITHUB_REDIRECT_URI is derived from this.
GATEWAY_URL=http://localhost:8000

GITHUB_TOKEN=ghp_replace_me
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# Optional. Defaults to ${GATEWAY_URL}/api/user/callback when unset.
# GITHUB_REDIRECT_URI=http://localhost:8000/api/user/callback

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=1
# REDIS_USERNAME=default

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

CB_FAILURE_THRESHOLD=5
CB_TIMEOUT_MS=30000
CB_SUCCESS_THRESHOLD=2

HTTP_REQUEST_TIMEOUT_MS=5000

AMQP_MAX_RETRIES=0
AMQP_RETRY_DELAY_MS=1000
AMQP_PREFETCH_COUNT=10

# F9: Organizations/Membership. On by default (unset = on). A deployed environment must run
# the backfills before first boot with it on; see plan/F9-teams-and-orgs.md "Cutover checklist".
# Rollback: ORGS_ENABLED=false (restart). Read plan/F9-teams-and-orgs.md "Cutover checklist"
# first: infrastructure-service refuses to start flag-off once org admins have created infrastructures.
ORGS_ENABLED=true

# Ownership transfer requires a login (auth_time) no older than this. Keep equal to
# EXIT_EXPORT_REAUTH_MAX_AGE_SECONDS in infrastructure-service.
EXIT_EXPORT_REAUTH_MAX_AGE_SECONDS=600

# Sent org.events outbox rows older than this many days are pruned.
ORG_EVENT_OUTBOX_RETENTION_DAYS=7
