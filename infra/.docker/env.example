POSTGRES_USER=launchpad
POSTGRES_PASSWORD=change-me
POSTGRES_DB=application_db
POSTGRES_PORT=5433
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=users_db
MYSQL_USER=launchpad
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=launchpad
MONGO_INITDB_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
REDIS_PORT=6379
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
GRAFANA_ADMIN_PASSWORD=change-me
TAG=latest

# Optional — set to have postgres-init.sh create the launchpad_dns_writer role for local
# testing of F1b's dns_writer process isolation. Leave unset to skip it entirely. After
# migrations run, apply the per-table grants with:
#   cd deployment-services/infrastructure-service && python manage.py apply_dns_writer_grants
# DNS_WRITER_DB_PASSWORD=change-me

# Optional (H7) — set either or both to also wire up a launchpad_dns_writer Redis ACL
# user (~platform_dns:* only) and/or RabbitMQ user (its own queues/exchange only) for
# local testing. Leave unset to skip — every other service's REDIS_PASSWORD/
# RABBITMQ_DEFAULT_USER auth is unaffected either way. See docs/PLATFORM_DNS_ISOLATION.md.
# DNS_WRITER_REDIS_PASSWORD=change-me
# DNS_WRITER_RABBITMQ_PASSWORD=change-me
