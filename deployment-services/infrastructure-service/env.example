DATABASE_USER_NAME=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=infrastructure_db
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
INFRASTRUCTURE_DB_URL=postgres://user:password@localhost:5433/infrastructure_db?ssl_mode=disable

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

DJANGO_SECRET=your-secret-key-min-50-characters-long-change-this-in-production
JWT_SECRET=your-jwt-secret-min-32-characters
DJANGO_PORT=8002
RUN_MAIN=true
INTERNAL_API_TOKEN=your-internal-api-token-min-32-characters

# Database Connection Pool
DB_CONN_MAX_AGE=600

# Run mode: prod (real AWS) or dev (mock AWS, no STS/terraform/boto3). Anything but dev is treated as prod.
MODE=prod

# AWS Credentials (Platform IAM User)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=3

# Per-user budget for the databases endpoints (F0) — requests per window per user.
RATE_BUDGET_DATABASES_LIMIT=60
RATE_BUDGET_DATABASES_WINDOW_SECONDS=60

# Per-user budget for the evidence-pack endpoint (F5) — requests per window per user.
RATE_BUDGET_EVIDENCE_LIMIT=10
RATE_BUDGET_EVIDENCE_WINDOW_SECONDS=300

# Launchpad platform IAM identity trusted by a customer's LaunchpadDeploymentRole trust
# policy. Must match app_scripts/create_aws_role.sh's LAUNCHPAD_PLATFORM_ACCOUNT_ID /
# LAUNCHPAD_PLATFORM_USER defaults unless the platform identity has rotated.
LAUNCHPAD_PLATFORM_PRINCIPAL_ARN=arn:aws:iam::221082203366:user/aklamaash-terraform

DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

AWS_MAX_RETRY_ATTEMPTS=10
AWS_RETRY_MODE=adaptive
AWS_CONNECT_TIMEOUT=10
AWS_READ_TIMEOUT=60

# EKS deployment target
EKS_ENABLED=False
# Comma-separated CIDRs allowed to reach an EKS cluster's public API endpoint (never 0.0.0.0/0)
EKS_PUBLIC_ACCESS_CIDRS=
