DATABASE_USER_NAME=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=infrastructure_db
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
INFRASTRUCTURE_DB_URL=postgres://user:password@localhost:5433/infrastructure_db?ssl_mode=disable

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

DJANGO_SECRET=your-secret-key-min-50-characters-long-change-this-in-production
JWT_SECRET=your-jwt-secret-min-32-characters
DJANGO_PORT=8002
RUN_MAIN=true
INTERNAL_API_TOKEN=your-internal-api-token-min-32-characters

# Database Connection Pool
DB_CONN_MAX_AGE=600

# Run mode: prod (real AWS) or dev (mock AWS, no STS/terraform/boto3). Anything but dev is treated as prod.
MODE=prod

# AWS Credentials (Platform IAM User)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=3

# Per-user budget for the databases endpoints (F0) — requests per window per user.
RATE_BUDGET_DATABASES_LIMIT=60
RATE_BUDGET_DATABASES_WINDOW_SECONDS=60

# Per-user budget for the evidence-pack endpoint (F5) — requests per window per user.
RATE_BUDGET_EVIDENCE_LIMIT=10
RATE_BUDGET_EVIDENCE_WINDOW_SECONDS=300

# Launchpad platform IAM identity trusted by a customer's LaunchpadDeploymentRole trust
# policy — must match whatever LAUNCHPAD_PLATFORM_ACCOUNT_ID / LAUNCHPAD_PLATFORM_USER
# this deployment's create_aws_role.sh actually uses. REQUIRED outside MODE=dev: no
# default is provided, since a wrong one would silently mistrust the wrong AWS principal
# in the evidence-pack live drift check.
LAUNCHPAD_PLATFORM_PRINCIPAL_ARN=arn:aws:iam::<your-platform-account-id>:user/<your-platform-iam-user>

# Per-user budget for the costs endpoint (F4) — requests per window per user.
RATE_BUDGET_COSTS_LIMIT=20
RATE_BUDGET_COSTS_WINDOW_SECONDS=60

# Bounded query window (months) for the costs endpoint.
COST_QUERY_MAX_MONTHS=3

# EKS cost-estimate pricing (F4) — AWS Fargate on-demand, us-east-1, Linux/x86; verified
# against aws.amazon.com/fargate/pricing and aws.amazon.com/eks/pricing on 2026-09-27.
COST_ESTIMATE_VCPU_HOUR_USD=0.040478
COST_ESTIMATE_GB_HOUR_USD=0.004446
COST_ESTIMATE_EKS_CONTROL_PLANE_HOUR_USD=0.10

DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

AWS_MAX_RETRY_ATTEMPTS=10
AWS_RETRY_MODE=adaptive
AWS_CONNECT_TIMEOUT=10
AWS_READ_TIMEOUT=60

# EKS deployment target
EKS_ENABLED=False
# Comma-separated CIDRs allowed to reach an EKS cluster's public API endpoint (never 0.0.0.0/0)
EKS_PUBLIC_ACCESS_CIDRS=

# --- Platform DNS writer (F1b) ---
# Set LAUNCHPAD_PROCESS_ROLE=dns_writer ONLY on the dedicated process that runs
# `manage.py run_dns_writer` / `manage.py sweep_platform_dns`. That role asserts
# JWT_SECRET, INTERNAL_API_TOKEN, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are ABSENT at
# startup — do not run it against this same .env file; give it its own env file with those
# four omitted and the PLATFORM_DNS_* values below added. Conversely, every OTHER process
# (this web/worker included) refuses to start if PLATFORM_DNS_ACCESS_KEY_ID or
# PLATFORM_DNS_SECRET_ACCESS_KEY is present in its environment — never put them here.
# LAUNCHPAD_PROCESS_ROLE=dns_writer

# Zone apex for platform-issued app hostnames: {slug}.{dns_label}.{this}. Read by every
# process (used for the custom-domain reserved-suffix check too — one settings source).
PLATFORM_BASE_DOMAIN=launchpad.app
# Only meaningful to the dns_writer role; from `terraform output` in infra/platform-dns.
PLATFORM_DNS_ZONE_ID=
PLATFORM_DNS_ACCOUNT_ID=
# Create with `aws iam create-access-key --user-name launchpad-platform-dns-writer` — see
# infra/platform-dns/README.md. Deliberately never a terraform resource.
PLATFORM_DNS_ACCESS_KEY_ID=
PLATFORM_DNS_SECRET_ACCESS_KEY=
