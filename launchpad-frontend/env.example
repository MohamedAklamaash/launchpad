# Public API base URL the dashboard talks to, including GitHub OAuth login. Falls back
# to localhost when unset. GitHub login must go through this origin, not auth-service
# directly — its callback lands here (see GITHUB_REDIRECT_URI in auth-service), and the
# CSRF-state cookie set on /login only matches at the callback on the same origin.
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000

# Optional. Serve the app under a sub-path (e.g. /dashboard). Empty = served at root.
# NEXT_PUBLIC_BASE_PATH=

# Onboarding script source. Only used in production builds — local dev reads the
# scripts from the repo directly, so these can stay unset for local work.
#   - NEXT_PUBLIC_LAUNCHPAD_SCRIPT_BASE_URL overrides everything (https:// or http://localhost).
#   - Otherwise the URL is pinned to NEXT_PUBLIC_LAUNCHPAD_SCRIPT_REF (commit SHA or signed tag)
#     on NEXT_PUBLIC_LAUNCHPAD_SCRIPT_REPO (defaults to the canonical repo).
# NEXT_PUBLIC_LAUNCHPAD_SCRIPT_BASE_URL=
# NEXT_PUBLIC_LAUNCHPAD_SCRIPT_REF=
# NEXT_PUBLIC_LAUNCHPAD_SCRIPT_REPO=
