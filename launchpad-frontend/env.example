# Public API base URL the dashboard talks to, including GitHub OAuth login. Falls back
# to localhost when unset. GitHub login must go through this origin, not auth-service
# directly — its callback lands here (see GITHUB_REDIRECT_URI in auth-service), and the
# CSRF-state cookie set on /login only matches at the callback on the same origin.
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000

# Optional. Serve the app under a sub-path (e.g. /dashboard). Empty = served at root.
# NEXT_PUBLIC_BASE_PATH=

# Onboarding script source. Only used in production builds — local dev reads the
# scripts from the repo directly, so these can stay unset for local work.
#   - NEXT_PUBLIC_LAUNCHPAD_SCRIPT_BASE_URL overrides everything (https:// or http://localhost).
#   - Otherwise the URL is pinned to NEXT_PUBLIC_LAUNCHPAD_SCRIPT_REF (commit SHA or signed tag)
#     on NEXT_PUBLIC_LAUNCHPAD_SCRIPT_REPO (defaults to the canonical repo).
# NEXT_PUBLIC_LAUNCHPAD_SCRIPT_BASE_URL=
# NEXT_PUBLIC_LAUNCHPAD_SCRIPT_REF=
# NEXT_PUBLIC_LAUNCHPAD_SCRIPT_REPO=

# F8: CloudFormation onboarding (the GUI-path alternative to create_aws_role.sh). Hidden
# entirely unless this flag is "true" — keep it in lockstep with the backend's own
# CFN_ONBOARDING_ENABLED (infrastructure-service). Flipping only this one on leaves the
# wizard tab/detail-page buttons visible but every call 404ing.
# NEXT_PUBLIC_CFN_ONBOARDING_ENABLED=false

# Required (no default — never hardcode a bucket name) once CFN onboarding is enabled:
# the platform template bucket's S3 base URL (virtual-hosted or path-style; or
# http://localhost for local iteration) and the git ref the templates were published
# under. See lib/onboarding-cloudformation.ts and
# plan/F8-cloudformation-onboarding.md §3/§4.
# NEXT_PUBLIC_LAUNCHPAD_CFN_TEMPLATE_BASE_URL=
# NEXT_PUBLIC_LAUNCHPAD_CFN_TEMPLATE_REF=

# F9: organizations (org switcher, members page, invite accept page, role-gated controls).
# On by default (unset = on). Rollback: set NEXT_PUBLIC_ORGS_ENABLED=false and rebuild (it is
# inlined at build time); the dashboard is then exactly the pre-F9 UI. Keep it in lockstep
# with the backend's ORGS_ENABLED (auth-service, infrastructure-service, application-service,
# payment-service): frontend on with a backend off makes the org calls 404.
# See plan/F9-teams-and-orgs.md, "Cutover checklist".
NEXT_PUBLIC_ORGS_ENABLED=true
